{
  "name": "wiola-helper",
  "version": "0.1.0",
  "description": "Wiola Helper - Kreisel invoice processing GUI",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "build:vite": "vite build",
    "dist": "vite build && electron-builder --win",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit"
  },
  "keywords": [],
  "author": "Patryk Baran",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "axios": "^1.17.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "form-data": "^4.0.5",
    "intuit-oauth": "^4.2.3",
    "mysql2": "^3.15.4",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "co.ewistore.wiolahelper",
    "productName": "Wiola Helper",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../system",
        "to": "kreisel-system",
        "filter": ["**/*.js", "**/*.json", ".env", "**/node_modules/**/*"]
      }
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "Wiola-Helper-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Wiola Helper"
    }
  }
}
